# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./aeris.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://aeris:aeris@localhost:5432/aeris

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: only needed for a commercial Open-Meteo plan.
OPEN_METEO_API_KEY=

# Nominatim requires an identifying User-Agent with a contact address.
GEOCODER_USER_AGENT=AERIS/0.1 (contact: you@example.com)

# Optional override of the config directory (defaults to ./config)
# AERIS_CONFIG_DIR=
